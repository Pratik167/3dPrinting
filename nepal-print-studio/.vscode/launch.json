{
  "version": "0.2.0",
  "configurations": [{
    "name": "Run Layer Studio in browser",
    "type": "node",
    "request": "launch",
    "program": "${workspaceFolder}/scripts/dev.mjs",
    "cwd": "${workspaceFolder}",
    "console": "integratedTerminal",
    "serverReadyAction": { "pattern": "Layer Studio running at (https?://[^\\s]+)", "uriFormat": "%s", "action": "openExternally" },
    "skipFiles": ["<node_internals>/**"]
  }]
}
